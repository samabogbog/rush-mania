{
  "name": "mossvale-game",
  "main": "index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "../client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mossvale-local",
      "database_id": "local",
      "migrations_dir": "../../drizzle"
    }
  ]
}